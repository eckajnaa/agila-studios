# Copy to .env.local and fill in. Never commit .env.local.

# Contact form (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Sender address. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to your own Resend account email until a domain is verified.
CONTACT_FROM_EMAIL=
